#!/usr/bin/env bash
# Start the Telegram bridge with secrets provided through the secure workspace environment.
set -euo pipefail
umask 077
BIN="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -r "$BIN/opencode-telegram-cgroup" ]; then . "$BIN/opencode-telegram-cgroup"; fi
ROOT="$(cd -- "$BIN/.." && pwd)"
DATA="$ROOT/data"
NODE="$(command -v node)"
# Keep the bridge's V8 heap modest so it never competes with the API server.
export NODE_OPTIONS="${NODE_OPTIONS:-} --max-old-space-size=256"
BRIDGE="$ROOT/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/cli.js"
: "${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is not configured}"
: "${TELEGRAM_ALLOWED_USER_ID:?TELEGRAM_ALLOWED_USER_ID is not configured}"
: "${OPENCODE_SERVER_PASSWORD:?OPENCODE_SERVER_PASSWORD is not configured}"
if [[ ! "$TELEGRAM_ALLOWED_USER_ID" =~ ^[0-9]+$ ]]; then echo 'TELEGRAM_ALLOWED_USER_ID must be numeric.' >&2; exit 1; fi
if [[ ! -f "$BRIDGE" ]]; then echo 'Telegram bridge package is not installed; run workspace setup.sh first.' >&2; exit 1; fi
mkdir -p "$DATA/bot" "$DATA/state" "$DATA/logs"
export HOME="$ROOT"
export PATH="$ROOT/runtime/opencode:$PATH"
export OPENCODE_TELEGRAM_HOME="$DATA/bot"
export XDG_STATE_HOME="$DATA/state"
export XDG_DATA_HOME="$DATA/opencode-data"
export XDG_CONFIG_HOME="$DATA/opencode-config"
export XDG_CACHE_HOME="$DATA/opencode-cache"
export OPENCODE_API_URL=http://127.0.0.1:4096
export OPENCODE_SERVER_USERNAME=opencode
export OPENCODE_MODEL_PROVIDER=opencode
export OPENCODE_MODEL_ID=mimo-v2.5-free
exec "$NODE" "$BRIDGE" start
