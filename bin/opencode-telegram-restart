#!/usr/bin/env bash
# Restart the local watchdog supervisor using the workspace-specific paths.
set -euo pipefail
umask 077
ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
DATA="$ROOT/data"
RUN="$DATA/run"
LOG="$DATA/logs"
mkdir -p "$RUN" "$LOG"
if [[ -s "$RUN/supervisor.pid" ]]; then
  old="$(<"$RUN/supervisor.pid")"
  if [[ "$old" =~ ^[0-9]+$ ]] && kill -0 "$old" 2>/dev/null; then kill "$old" 2>/dev/null || true; fi
fi
setsid "$ROOT/bin/opencode-telegram-supervise" >> "$LOG/supervisor.log" 2>&1 < /dev/null &
echo $! > "$RUN/supervisor.pid"
printf 'Started watchdog supervisor (PID %s).\n' "$(<"$RUN/supervisor.pid")"
