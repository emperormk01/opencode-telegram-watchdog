#!/usr/bin/env bash
# Keep the local OpenCode server and Telegram bridge alive on this workspace.
set -euo pipefail
umask 077
BIN="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [ -r "$BIN/opencode-telegram-cgroup" ]; then . "$BIN/opencode-telegram-cgroup"; fi
ROOT="$(cd -- "$BIN/.." && pwd)"
WORKSPACE="$(cd -- "$ROOT/.." && pwd)"
DATA="$ROOT/data"
RUN="$DATA/run"
LOG="$DATA/logs"
SERVER="$ROOT/bin/opencode-telegram-server"
BRIDGE="$ROOT/bin/opencode-telegram-bridge"
mkdir -p "$RUN" "$LOG"
# Secrets come from the workspace environment (never from this repository).
if [[ -f "$WORKSPACE/.env" ]]; then
  set -a
  source "$WORKSPACE/.env"
  set +a
fi
if [[ -z "${OPENCODE_SERVER_PASSWORD:-}" && -f "$DATA/.server-password" ]]; then
  export OPENCODE_SERVER_PASSWORD="$(<"$DATA/.server-password")"
fi
exec 9>"$RUN/supervisor.lock"
if ! flock -n 9; then exit 0; fi
sleeper="${OPENCODE_TELEGRAM_SUPERVISOR_INTERVAL:-20}"
server_pid=''
bridge_pid=''
stop_all() {
  trap - TERM INT EXIT
  for p in "$bridge_pid" "$server_pid"; do
    [[ -n "$p" ]] || continue
    kill "$p" 2>/dev/null || true
  done
  for p in "$bridge_pid" "$server_pid"; do
    [[ -n "$p" ]] || continue
    wait "$p" 2>/dev/null || true
  done
}
trap stop_all TERM INT EXIT
server_healthy() {
  curl --silent --fail --max-time 2 -u "opencode:${OPENCODE_SERVER_PASSWORD:-}" \
    http://127.0.0.1:4096/global/health >/dev/null 2>&1
}
wait_for_server() {
  local i
  for ((i = 0; i < 40; i++)); do
    if server_healthy; then
      printf '%s\n' ''
      return 0
    fi
    sleep 1
  done
  return 1
}
start_service() {
  local name="$1" path="$2"; shift 2
  if [[ "$name" == server ]] && server_healthy; then
    printf '%s\n' ''
    return 0
  fi
  if [[ "$name" == bridge && -n "${bridge_pid:-}" ]] && kill -0 "$bridge_pid" 2>/dev/null; then
    printf '%s\n' ''
    return 0
  fi
  printf '%s: launching service at %s\n' "$name" "$(date -u +%FT%TZ)" >> "$LOG/supervisor.log"
  setsid "$path" >> "$LOG/${name}.log" 2>&1 < /dev/null &
  printf '%s\n' "$!"
}
server_pid="$(start_service server "$SERVER" "$ROOT/runtime/opencode/opencode" || true)"
# The bridge probes the API server once at startup; bring the server up first.
if ! wait_for_server; then
  printf 'watchdog warning at %s; OpenCode server did not report healthy within 40s\n' "$(date -u +%FT%TZ)" >> "$LOG/supervisor.log"
fi
bridge_pid="$(start_service bridge "$ROOT/data/start-bridge.sh" "$ROOT/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/cli.js" || true)"
printf 'watchdog started at %s; server_pid=%s bridge_pid=%s\n' "$(date -u +%FT%TZ)" "${server_pid:-none}" "${bridge_pid:-none}" >> "$LOG/supervisor.log"
while true; do
  if [[ -n "$server_pid" ]] && ! kill -0 "$server_pid" 2>/dev/null; then server_pid=''; fi
  if [[ -n "$bridge_pid" ]] && ! kill -0 "$bridge_pid" 2>/dev/null; then bridge_pid=''; fi
  if [[ -z "$server_pid" ]]; then
    server_pid="$(start_service server "$SERVER" "$ROOT/runtime/opencode/opencode" || true)"
    wait_for_server || true
  fi
  if [[ -z "$bridge_pid" ]]; then
    bridge_pid="$(start_service bridge "$ROOT/data/start-bridge.sh" "$ROOT/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/cli.js" || true)"
  fi
  printf 'watchdog checked at %s; server_pid=%s bridge_pid=%s\n' "$(date -u +%FT%TZ)" "${server_pid:-none}" "${bridge_pid:-none}" >> "$LOG/supervisor.log"
  sleep "$sleeper" & wait $! || true
done
