+// Refresh the Telegram "/" command menu on every boot so it always matches the
+// registered commands (Telegram clients cache the menu aggressively).
+async function refreshCommandsMenu(bot) {
+    try {
+        await bot.api.setMyCommands(BOT_COMMANDS);
+        logger.info("[Bot] Commands menu refreshed at startup");
+    }
+    catch (error) {
+        logger.warn("[Bot] Failed to refresh commands menu at startup:", error);
+    }
+}
+// If the previous bridge process restarted itself via /opencode_restart, it left
+// a marker file; edit its status message to the final "✅ Restarted." text.
+async function confirmPendingRestart(bot) {
+    const pendingPath = path.join(getRuntimePaths().appHome, "pending-restart.json");
+    try {
+        await fs.access(pendingPath);
+    }
+    catch {
+        return;
+    }
+    try {
+        const pending = JSON.parse(await fs.readFile(pendingPath, "utf8"));
+        await editBotText({
+            api: bot.api,
+            chatId: pending.chatId,
+            messageId: pending.messageId,
+            text: t("opencode_restart.done"),
+        });
+        logger.info("[Bot] Pending restart confirmation delivered");
+    }
+    catch (error) {
+        logger.warn("[Bot] Failed to deliver pending restart confirmation:", error);
+    }
+    finally {
+        await fs.rm(pendingPath, { force: true }).catch(() => { });
+    }
