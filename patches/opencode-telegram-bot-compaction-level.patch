diff --git a/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/compaction-level-command.js b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/compaction-level-command.js
new file mode 100644
--- /dev/null
+++ b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/compaction-level-command.js
@@ -0,0 +1,41 @@
+import { InlineKeyboard } from "grammy";
+import { replyWithInlineMenu } from "../menus/inline-menu.js";
+import { isForegroundBusy } from "../../app/services/run-control-service.js";
+import { replyBusyBlocked } from "../messages/busy-blocked-renderer.js";
+import { logger } from "../../utils/logger.js";
+import { t } from "../../i18n/index.js";
+export const COMPACTION_LEVEL_CALLBACK_PREFIX = "cplvl:";
+export const COMPACTION_LEVEL_SET_PREFIX = `${COMPACTION_LEVEL_CALLBACK_PREFIX}set:`;
+export const COMPACTION_LEVEL_PERCENTS = [50, 60, 70, 80, 90];
+export async function buildCompactionLevelMenuView(currentPercent) {
+    const keyboard = new InlineKeyboard();
+    COMPACTION_LEVEL_PERCENTS.forEach((percent, index) => {
+        keyboard.text(`${percent}%`, `${COMPACTION_LEVEL_SET_PREFIX}${percent}`);
+        if ((index + 1) % 3 === 0) {
+            keyboard.row();
+        }
+    });
+    return {
+        text: t("cplvl.select", { current: currentPercent === null ? "unknown" : `${currentPercent}%` }),
+        keyboard,
+    };
+}
+export async function compactionLevelCommand(ctx) {
+    try {
+        if (isForegroundBusy()) {
+            await replyBusyBlocked(ctx);
+            return;
+        }
+        logger.debug("[CompactionLevel] Opening compaction level menu");
+        const { text, keyboard } = await buildCompactionLevelMenuView(null);
+        await replyWithInlineMenu(ctx, {
+            menuKind: "cplvl",
+            text,
+            keyboard,
+        });
+    }
+    catch (error) {
+        logger.error("[CompactionLevel] Error opening menu:", error);
+        await ctx.reply(t("cplvl.error"));
+    }
+}
diff --git a/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/compaction-level-callback-handler.js b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/compaction-level-callback-handler.js
new file mode 100644
--- /dev/null
+++ b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/compaction-level-callback-handler.js
@@ -0,0 +1,112 @@
+import { opencodeClient } from "../../opencode/client.js";
+import { getCurrentModel } from "../../app/stores/settings-store.js";
+import { getModelContextLimit } from "../../app/services/model-context-limit-service.js";
+import { clearAllInteractionState } from "../../app/managers/interaction-manager.js";
+import { ensureActiveInlineMenu } from "../menus/inline-menu.js";
+import { isForegroundBusy } from "../../app/services/run-control-service.js";
+import { replyBusyBlocked } from "../messages/busy-blocked-renderer.js";
+import { COMPACTION_LEVEL_CALLBACK_PREFIX, COMPACTION_LEVEL_SET_PREFIX, COMPACTION_LEVEL_PERCENTS, } from "../commands/compaction-level-command.js";
+import { logger } from "../../utils/logger.js";
+import { t } from "../../i18n/index.js";
+import { notify, failure } from "./feedback.js";
+import fs from "node:fs";
+import path from "node:path";
+function getConfigFilePath() {
+    const xdgConfigHome = process.env.XDG_CONFIG_HOME;
+    if (!xdgConfigHome) {
+        return null;
+    }
+    return path.join(xdgConfigHome, "opencode", "opencode.jsonc");
+}
+function loadConfigFile(filePath) {
+    if (!fs.existsSync(filePath)) {
+        return { $schema: "https://opencode.ai/config.json" };
+    }
+    const text = fs.readFileSync(filePath, "utf8");
+    try {
+        const parsed = JSON.parse(text);
+        return parsed && typeof parsed === "object" && !Array.isArray(parsed) ? parsed : {};
+    }
+    catch (err) {
+        logger.warn(`[CompactionLevel] Config file not valid JSON (${filePath}); treating as empty:`, err);
+        return {};
+    }
+}
+function persistCompactionConfig(reserved) {
+    const filePath = getConfigFilePath();
+    if (!filePath) {
+        return false;
+    }
+    try {
+        const parsed = loadConfigFile(filePath);
+        parsed.compaction = parsed.compaction ?? {};
+        parsed.compaction.reserved = reserved;
+        fs.writeFileSync(filePath, `${JSON.stringify(parsed, null, 2)}\n`, "utf8");
+        return true;
+    }
+    catch (err) {
+        logger.error("[CompactionLevel] Failed to persist compaction config:", err);
+        return false;
+    }
+}
+async function currentContextLimit() {
+    const model = getCurrentModel();
+    if (!model?.providerID || !model?.modelID) {
+        return null;
+    }
+    return getModelContextLimit(model.providerID, model.modelID);
+}
+export async function handleCompactionLevelCallback(ctx) {
+    const data = ctx.callbackQuery?.data;
+    if (!data || !data.startsWith(COMPACTION_LEVEL_CALLBACK_PREFIX)) {
+        return false;
+    }
+    if (isForegroundBusy()) {
+        await replyBusyBlocked(ctx);
+        return true;
+    }
+    const isActiveMenu = await ensureActiveInlineMenu(ctx, "cplvl");
+    if (!isActiveMenu) {
+        return true;
+    }
+    if (!data.startsWith(COMPACTION_LEVEL_SET_PREFIX)) {
+        await notify(ctx, "callback.processing_error");
+        return true;
+    }
+    const rawPercent = data.slice(COMPACTION_LEVEL_SET_PREFIX.length);
+    const percent = Number(rawPercent);
+    if (!COMPACTION_LEVEL_PERCENTS.includes(percent)) {
+        await notify(ctx, "callback.processing_error");
+        return true;
+    }
+    try {
+        const contextLimit = await currentContextLimit();
+        if (!contextLimit) {
+            clearAllInteractionState("cplvl_no_model");
+            await failure(ctx, "cplvl.no_model");
+            return true;
+        }
+        const reserved = Math.round((contextLimit * (100 - percent)) / 100);
+        const { error } = await opencodeClient.config.update({
+            config: { compaction: { reserved } },
+        });
+        if (error) {
+            logger.error("[CompactionLevel] Apply failed:", error);
+            await notify(ctx, "cplvl.apply_failed");
+            return true;
+        }
+        const persisted = persistCompactionConfig(reserved);
+        if (!persisted) {
+            logger.warn("[CompactionLevel] Applied live but could not persist to config file");
+        }
+        clearAllInteractionState("cplvl_set");
+        await ctx.answerCallbackQuery();
+        await ctx.editMessageText(t("cplvl.set", { percent, reserved: reserved.toLocaleString() }));
+    }
+    catch (error) {
+        clearAllInteractionState("cplvl_error");
+        logger.error("[CompactionLevel] Error applying compaction level:", error);
+        await failure(ctx, "cplvl.apply_failed");
+    }
+    return true;
+}
