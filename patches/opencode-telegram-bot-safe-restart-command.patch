--- /dev/null
+++ b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/opencode-restart-command.js
@@ -0,0 +1,14 @@
+import { logger } from "../../utils/logger.js";
+import { t } from "../../i18n/index.js";
+
+/**
+ * Restart only the Telegram bridge process.
+ * The external supervisor relaunches it; the OpenCode server and session stay alive.
+ */
+export async function opencodeRestartCommand(ctx) {
+    await ctx.reply(t("opencode_restart.restarting"));
+    logger.info("[Bot] Safe bridge restart requested via /opencode_restart");
+    setTimeout(() => {
+        process.kill(process.pid, "SIGTERM");
+    }, 500);
+}
