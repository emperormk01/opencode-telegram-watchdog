+// If the previous bridge process restarted itself via /opencode_restart, it left
+// a marker file; edit its status message to the final "✅ Restarted." text.
+async function confirmPendingRestart(bot) {
+    const pendingPath = path.join(getRuntimePaths().appHome, "pending-restart.json");
+    try {
+        await fs.access(pendingPath);
+    }
+    catch {
+        return;
+    }
+    try {
+        const content = JSON.parse(await fs.readFile(pendingPath, "utf-8"));
+        await bot.api.editMessageText(content.chatId, content.messageId, t("opencode_restart.done"));
+        await fs.rm(pendingPath).catch(() => {});
+        logger.info("[Bot] Edited pending restart message to '✅ Restarted.'");
+    }
+    catch (error) {
+        logger.debug("[Bot] Could not edit pending restart message:", error.message);
+    }
