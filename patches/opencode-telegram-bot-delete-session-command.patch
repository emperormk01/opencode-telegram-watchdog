@@ -0,0 +1,62 @@
+import { InlineKeyboard } from "grammy";
+import { getCurrentProject } from "../../app/stores/settings-store.js";
+import { replyWithInlineMenu } from "../menus/inline-menu.js";
+import { isForegroundBusy } from "../../app/services/run-control-service.js";
+import { replyBusyBlocked } from "../messages/busy-blocked-renderer.js";
+import { loadSessionPage } from "../menus/session-selection-menu.js";
+import { logger } from "../../utils/logger.js";
+import { config } from "../../config.js";
+import { getDateLocale, t } from "../../i18n/index.js";
+export const DELETE_SESSION_CALLBACK_PREFIX = "delses:";
+export const DELETE_SESSION_PAGE_CALLBACK_PREFIX = `${DELETE_SESSION_CALLBACK_PREFIX}page:`;
+export const DELETE_SESSION_CONFIRM_CALLBACK_PREFIX = `${DELETE_SESSION_CALLBACK_PREFIX}confirm:`;
+export const DELETE_SESSION_CANCEL_CALLBACK_PREFIX = `${DELETE_SESSION_CALLBACK_PREFIX}cancel:`;
+export function buildDeleteSessionKeyboard(pageData, pageSize) {
+    const keyboard = new InlineKeyboard();
+    const localeForDate = getDateLocale();
+    const pageStartIndex = pageData.page * pageSize;
+    pageData.sessions.forEach((session, index) => {
+        const date = new Date(session.time.created).toLocaleDateString(localeForDate);
+        const label = `${pageStartIndex + index + 1}. ${session.title} (${date})`;
+        keyboard.text(label, `${DELETE_SESSION_CALLBACK_PREFIX}${session.id}`).row();
+    });
+    if (pageData.page > 0) {
+        keyboard.text(t("sessions.button.prev_page"), `${DELETE_SESSION_PAGE_CALLBACK_PREFIX}${pageData.page - 1}`);
+    }
+    if (pageData.hasNext) {
+        keyboard.text(t("sessions.button.next_page"), `${DELETE_SESSION_PAGE_CALLBACK_PREFIX}${pageData.page + 1}`);
+    }
+    if (pageData.page > 0 || pageData.hasNext) {
+        keyboard.row();
+    }
+    return keyboard;
+}
+export async function deleteSessionCommand(ctx) {
+    try {
+        if (isForegroundBusy()) {
+            await replyBusyBlocked(ctx);
+            return;
+        }
+        const pageSize = config.bot.sessionsListLimit;
+        const currentProject = getCurrentProject();
+        if (!currentProject) {
+            await ctx.reply(t("sessions.project_not_selected"));
+            return;
+        }
+        logger.debug(`[DeleteSession] Fetching sessions for directory: ${currentProject.worktree}`);
+        const firstPage = await loadSessionPage(currentProject.worktree, 0, pageSize);
+        if (firstPage.sessions.length === 0) {
+            await ctx.reply(t("delses.empty"));
+            return;
+        }
+        await replyWithInlineMenu(ctx, {
+            menuKind: "delses",
+            text: t("delses.select"),
+            keyboard: buildDeleteSessionKeyboard(firstPage, pageSize),
+        });
+    }
+    catch (error) {
+        logger.error("[DeleteSession] Error fetching sessions:", error);
+        await ctx.reply(t("delses.fetch_error"));
+    }
+}
diff --git a/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/delete-session-callback-handler.js b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/delete-session-callback-handler.js
new file mode 100644
--- /dev/null
+++ b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/callbacks/delete-session-callback-handler.js
@@ -0,0 +1,140 @@
+import { InlineKeyboard } from "grammy";
+import { opencodeClient } from "../../opencode/client.js";
+import { getCurrentProject } from "../../app/stores/settings-store.js";
+import { getCurrentSession, clearSession } from "../../app/services/session-service.js";
+import { detachAttachedSession } from "../../app/services/attach-service.js";
+import { clearAllInteractionState } from "../../app/managers/interaction-manager.js";
+import { appendInlineMenuCancelButton, ensureActiveInlineMenu } from "../menus/inline-menu.js";
+import { isForegroundBusy } from "../../app/services/run-control-service.js";
+import { replyBusyBlocked } from "../messages/busy-blocked-renderer.js";
+import { loadSessionPage } from "../menus/session-selection-menu.js";
+import { buildDeleteSessionKeyboard, DELETE_SESSION_CALLBACK_PREFIX, DELETE_SESSION_CANCEL_CALLBACK_PREFIX, DELETE_SESSION_CONFIRM_CALLBACK_PREFIX, DELETE_SESSION_PAGE_CALLBACK_PREFIX, } from "../commands/delete-session-command.js";
+import { logger } from "../../utils/logger.js";
+import { config } from "../../config.js";
+import { t } from "../../i18n/index.js";
+import { failure } from "./feedback.js";
+export async function handleDeleteSessionCallback(ctx) {
+    const data = ctx.callbackQuery?.data;
+    if (!data || !data.startsWith(DELETE_SESSION_CALLBACK_PREFIX)) {
+        return false;
+    }
+    if (isForegroundBusy()) {
+        await replyBusyBlocked(ctx);
+        return true;
+    }
+    const isActiveMenu = await ensureActiveInlineMenu(ctx, "delses");
+    if (!isActiveMenu) {
+        return true;
+    }
+    const payload = data.slice(DELETE_SESSION_CALLBACK_PREFIX.length);
+    try {
+        if (payload.startsWith("page:")) {
+            await handleDeleteSessionPage(ctx, payload.slice("page:".length));
+            return true;
+        }
+        if (payload.startsWith("confirm:")) {
+            await handleDeleteSessionConfirm(ctx, payload.slice("confirm:".length));
+            return true;
+        }
+        if (payload.startsWith("cancel:")) {
+            const sessionId = payload.slice("cancel:".length);
+            clearAllInteractionState("delses_cancelled");
+            await ctx.answerCallbackQuery();
+            await ctx.editMessageText(t("delses.cancelled"));
+            return true;
+        }
+        await askDeleteSessionConfirmation(ctx, payload);
+    }
+    catch (error) {
+        clearAllInteractionState("delses_error");
+        logger.error("[DeleteSession] Error handling callback:", error);
+        await failure(ctx, "delses.error");
+    }
+    return true;
+}
+async function handleDeleteSessionPage(ctx, rawPage) {
+    const page = Number(rawPage);
+    if (!Number.isInteger(page) || page < 0) {
+        await ctx.answerCallbackQuery({ text: t("callback.processing_error") });
+        return;
+    }
+    const currentProject = getCurrentProject();
+    if (!currentProject) {
+        clearAllInteractionState("delses_project_missing");
+        await failure(ctx, "sessions.select_project_first");
+        return;
+    }
+    try {
+        const pageSize = config.bot.sessionsListLimit;
+        const pageData = await loadSessionPage(currentProject.worktree, page, pageSize);
+        if (pageData.sessions.length === 0) {
+            await ctx.answerCallbackQuery({ text: t("sessions.page_empty_callback") });
+            return;
+        }
+        const keyboard = buildDeleteSessionKeyboard(pageData, pageSize);
+        appendInlineMenuCancelButton(keyboard, "delses");
+        await ctx.answerCallbackQuery();
+        await ctx.editMessageText(t("delses.select_page", { page: page + 1 }), {
+            reply_markup: keyboard,
+        });
+    }
+    catch (error) {
+        logger.error("[DeleteSession] Error loading sessions page:", error);
+        await ctx.answerCallbackQuery({ text: t("sessions.page_load_error_callback") });
+    }
+}
+async function fetchSessionById(sessionId) {
+    const currentProject = getCurrentProject();
+    if (!currentProject) {
+        return null;
+    }
+    const { data: session, error } = await opencodeClient.session.get({
+        sessionID: sessionId,
+        directory: currentProject.worktree,
+    });
+    if (error || !session) {
+        return null;
+    }
+    return session;
+}
+async function askDeleteSessionConfirmation(ctx, sessionId) {
+    if (!sessionId) {
+        await ctx.answerCallbackQuery({ text: t("callback.processing_error") });
+        return;
+    }
+    const session = await fetchSessionById(sessionId);
+    if (!session) {
+        await ctx.answerCallbackQuery({ text: t("delses.not_found") });
+        return;
+    }
+    const keyboard = new InlineKeyboard()
+        .text(t("delses.button.yes"), `${DELETE_SESSION_CONFIRM_CALLBACK_PREFIX}${sessionId}`)
+        .text(t("delses.button.no"), `${DELETE_SESSION_CANCEL_CALLBACK_PREFIX}${sessionId}`);
+    await ctx.answerCallbackQuery();
+    await ctx.editMessageText(t("delses.confirm", { title: session.title }), {
+        reply_markup: keyboard,
+    });
+}
+async function handleDeleteSessionConfirm(ctx, sessionId) {
+    if (!sessionId) {
+        await ctx.answerCallbackQuery({ text: t("callback.processing_error") });
+        return;
+    }
+    const session = await fetchSessionById(sessionId);
+    const { error } = await opencodeClient.session.delete({ sessionID: sessionId });
+    if (error) {
+        logger.error("[DeleteSession] Failed to delete session:", error);
+        await ctx.answerCallbackQuery({ text: t("delses.delete_error") });
+        return;
+    }
+    logger.info(`[DeleteSession] Session deleted: id=${sessionId}, title="${session?.title ?? "unknown"}"`);
+    const current = getCurrentSession();
+    if (current && current.id === sessionId) {
+        logger.info("[DeleteSession] Deleted session was the active one; clearing local session state");
+        detachAttachedSession("session_deleted");
+        clearSession();
+    }
+    clearAllInteractionState("delses_deleted");
+    await ctx.answerCallbackQuery();
+    await ctx.editMessageText(t("delses.deleted", { title: session?.title ?? sessionId }));
+}
