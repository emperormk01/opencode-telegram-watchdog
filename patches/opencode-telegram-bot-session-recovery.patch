+function isSessionNotFoundError(error) {
+    if (!error) {
+        return false;
+    }
+    // Opencode returns NotFoundError with `Session not found: <id>` when the
+    // server has restarted and its in-memory session store was wiped (e.g. a
+    // Telegram `/stop` + `/start`). The bridge must not keep reusing the stale
+    // id forever — detect it and recreate a fresh session.
+    const name = error.name;
+    const data = error.data;
+    const message = typeof data === "object" && data !== null ? data.message : null;
+    if (name === "NotFoundError" && typeof message === "string" && /session/i.test(message) && /not found/i.test(message)) {
+        return true;
+    }
+    const raw = typeof error === "string"
+        ? error
+        : `${JSON.stringify(error)}`;
+    return /session/i.test(raw) && /not\s+found/i.test(raw);
+}
+
+// Recreate the session that a freshly-restarted OpenCode server no longer
+// knows about, so subsequent prompts work again without a manual /new.
+async function recoverStaleSession() {
+    const currentProject = getCurrentProject();
+    if (!currentProject) {
+        return null;
+    }
+    logger.warn("[Bot] Stale session detected (OpenCode restarted); recreating session");
+    const { data: session, error } = await opencodeClient.session.create({
+        directory: currentProject.worktree,
+    });
+    if (error || !session) {
+        logger.error("[Bot] Failed to recreate session after stale-session detection:", error ?? "no data");
+        return null;
+    }
+    const sessionInfo = {
+        id: session.id,
+        title: session.title,
+        directory: currentProject.worktree,
+    };
+    setCurrentSession(sessionInfo);
+    clearAllInteractionState("session_recreated");
+    await ingestSessionInfoForCache(session);
+    logger.info(`[Bot] Recreated stale session: id=${session.id}`);
+    return sessionInfo;
+}
