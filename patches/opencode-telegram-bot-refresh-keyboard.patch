diff --git a/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/refresh-keyboard-command.js b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/refresh-keyboard-command.js
new file mode  100644
--- /dev/null
+++ b/runtime/opencode-telegram-bot/node_modules/@grinev/opencode-telegram-bot/dist/bot/commands/refresh-keyboard-command.js
@@ -0,0 +1,48 @@
+import { keyboardManager } from "../keyboards/keyboard-manager.js";
+import { t } from "../../i18n/index.js";
+import { getCurrentSession } from "../../app/services/session-service.js";
+import { createMainKeyboard } from "../keyboards/main-reply-keyboard.js";
+import { getStoredModel } from "../../app/services/model-selection-service.js";
+import { formatVariantForButton } from "../../app/services/variant-selection-service.js";
+import { logger } from "../../utils/logger.js";
+
+/**
+ * Refresh the reply keyboard by re-initializing the keyboard manager
+ * and getting the current keyboard state.
+ * This is useful when the keyboard buttons are not displaying correctly.
+ */
+export async function refreshKeyboardCommand(ctx) {
+    if (!ctx.chat || !ctx.api) {
+        return;
+    }
+
+    try {
+        // Initialize the keyboard manager with the current API and chat
+        keyboardManager.initialize(ctx.api, ctx.chat.id);
+        
+        // Get current model info
+        const storedModel = getStoredModel();
+        const variantName = formatVariantForButton(storedModel.variant || "default");
+        const contextInfo = keyboardManager.getContextInfo();
+        
+        // Build the keyboard with current state
+        const keyboard = createMainKeyboard(
+            keyboardManager.getState()?.currentAgent || "agent",
+            storedModel,
+            contextInfo ?? undefined,
+            variantName
+        );
+        
+        await ctx.reply(t("refresh_keyboard.success"), { reply_markup: keyboard });
+    }
+    catch (error) {
+        logger.warn("[Bot] Error refreshing keyboard:", error);
+        await ctx.reply(t("refresh_keyboard.error"));
+    }
+}
